#!/bin/sh
# LTE 保活 + 断网自愈（OpenWrt / netifd 版）
#
# 为什么需要保活：本机 2015 年 MPSS 固件在 LTE 空闲态（ECM-IDLE）收不到网络
# 寻呼，短信会延迟几分钟。周期发一个 ICMP 包让链路保持连接态，代价约 0.5MB/天。
#
# 自愈：连续 FAIL_LIMIT 次 ping 失败（或 wwan0 没有 IPv4）→ 重拨。
# 重拨走 netifd（ifdown/ifup modem），不直接碰 /dev/wwan0atN
# （ModemManager 在用，抢了会话短信就丢）。
# 两次恢复尝试至少间隔 RECOVER_COOLDOWN 秒。
#
# 判活用源地址（ping -I <wwan0 的 IPv4>）：qmi_wwan 上绑定设备的
# `ping -I wwan0` 会误报不可达 —— 同一时刻按源地址 ping 是通的，
# 用设备名判活会假失败、反复空重拨。
#
# 基带等待（jz02v10）：MPSS 开机后会连续 watchdog 复位，每次起来空等 40.05 秒
# 被看门狗咬掉，通常 4 轮、约 3 分半才稳定。这期间 mmcli 看不到 modem、
# wwan0 连 QMI 端口都没有，此时 ifdown/ifup 是空转 —— netifd 没有 modem 可拨，
# 只会刷一串 WARN 并把恢复冷却白白推后。所以把「基带在不在」和「链路通不通」
# 分开判断：没有 modem 就静默等待、不计失败次数；基带一出现再给 GRACE 秒
# 宽限，让它自己完成附着，避免刚 attach 就被我们重拨打断。
#
# 频段（可选，UCI smsrelay.main.bands）：jz02v10 的模组默认只开 eutran-1/3/5，
# 到了移动 band 8/39/40 覆盖的区域就会「手机有信号、模组扫不到 46000」，
# 表现为注册不上、一直 searching。填完整频段列表即可放开；留空则完全不碰模组。
# 下发的值会先与本机 supported 求交集，所以同一份配置可以跨机型共用
# （sp970 只支持 eutran-1/3/5，写全套只会被裁到它支持的部分，不会报错）。

IFACE=wwan0
NETIF=modem
TARGET=223.5.5.5
INTERVAL=10
FAIL_LIMIT=3
RECOVER_COOLDOWN=300
GRACE=30

# 可选 UCI 覆盖：modem 编号与频段（缺省时行为与以前完全一致）
MODEM=$(uci -q get smsrelay.main.modem_index 2>/dev/null)
MODEM=${MODEM:-0}
# 频段统一成 mmcli 认的竖线分隔（配置里写逗号也认）
BANDS=$(uci -q get smsrelay.main.bands 2>/dev/null | tr -d ' ' | tr ',' '|')

fails=0
last_recover=0
waiting=0
grace_until=0
bands_done=0
bands_try=0

log() { logger -t smsrelay-keepalive "$@"; }

# wwan0 的 IPv4（/30 点对点，取第一个即可）
wwan_ip() {
	ip -4 addr show "$IFACE" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\)\/.*/\1/p' | head -n1
}

has_ip() { [ -n "$(wwan_ip)" ]; }

# 按源地址 ping，见文件头「判活用源地址」
ping_ok() {
	local ip
	ip=$(wwan_ip)
	[ -n "$ip" ] || return 1
	ping -I "$ip" -c 1 -W 3 -q "$TARGET" >/dev/null 2>&1
}

# 基带是否已被 ModemManager 认到。没装 mmcli 时退化为看 QMI 端口节点。
modem_present() {
	if command -v mmcli >/dev/null 2>&1; then
		mmcli -L 2>/dev/null | grep -q 'ModemManager1/Modem'
	else
		[ -e /dev/wwan0qmi0 ]
	fi
}

# 归一成「排序去重、竖线分隔」，与 mmcli 输出比对时用这个形式
norm() {
	printf '%s' "$1" | tr '|' '\n' | sed '/^$/d' | sort -u | tr '\n' '|' | sed 's/|$//'
}

# 两个竖线分隔集合求交集（结果已归一）
intersect() {
	local out="" b
	for b in $(printf '%s' "$1" | tr '|' ' '); do
		case "|$2|" in
			*"|$b|"*) out="${out}${out:+|}$b" ;;
		esac
	done
	norm "$out"
}

# 取 mmcli Bands 段里 supported: / current: 的频段集合。mmcli 会把长列表折行，
# 续行只有竖线和频段名，所以一路吃到本段的字段分隔线为止。
bands_of() {
	mmcli -m "$MODEM" 2>/dev/null \
		| awk -v key="$1:" '
			/Bands/ { b = 1 }
			b && /^  ---/ { exit }
			b && index($0, key) { f = 1 }
			f && b { print }
		' \
		| sed "s/^.*$1: *//; s/^ *| *//" \
		| tr ',' '\n' | tr -d ' ' \
		| grep -E '^(egsm|dcs|pcs|g850|utran-[0-9]+|eutran-[0-9]+)$' \
		| sort -u | tr '\n' '|' | sed 's/|$//'
}

current_bands() { bands_of current; }
supported_bands() { bands_of supported; }

# 已经是目标频段就不动 —— 否则每次服务重启都会让模组重扫、短暂断链。
# 只会下发「配置 ∩ 本机 supported」：配置可以按机型无关写，跨机型共用不会失败
# （SP970 只支持 egsm/dcs/pcs/g850/utran-1/5/eutran-1/3/5，写全套会被裁到它支持的部分）。
apply_bands() {
	local want full have
	[ -n "$BANDS" ] || return 0
	command -v mmcli >/dev/null 2>&1 || return 1
	full=$(norm "$BANDS")
	want=$full
	have=$(supported_bands)
	if [ -n "$have" ]; then
		want=$(intersect "$full" "$have")
		if [ -z "$want" ]; then
			log "WARN 配置的频段本机都不支持（$full），跳过设置"
			return 0
		fi
		[ "$want" = "$full" ] || log "配置的频段按本机支持裁剪：$full → $want"
	fi
	[ "$(current_bands)" = "$want" ] && return 0
	if mmcli -m "$MODEM" --set-current-bands="$want" >/dev/null 2>&1; then
		log "频段已设置：$want"
		return 0
	fi
	return 1
}

recover() {
	now=$(date +%s)
	if [ $((now - last_recover)) -lt "$RECOVER_COOLDOWN" ]; then
		return 1
	fi
	last_recover=$now
	if has_ip; then
		log "WARN 连续 $fails 次 ping 不通，强制重拨 LTE"
	else
		log "WARN $IFACE 无 IPv4（连续 $fails 次），重拨 LTE"
	fi
	ifdown "$NETIF" 2>/dev/null
	sleep 3
	ifup "$NETIF" 2>/dev/null
	sleep 20
	if ping_ok; then
		log "LTE 已恢复（重拨成功）"
		return 0
	fi
	log "WARN 重拨后仍不通，${RECOVER_COOLDOWN}s 后自动再试"
	return 1
}

log "keepalive 启动：iface=$IFACE netif=$NETIF interval=${INTERVAL}s bands=${BANDS:-未配置}"
while true; do
	if ! modem_present; then
		if [ "$waiting" = 0 ]; then
			log "基带未就绪（MPSS 重启中），暂停保活，等 modem 出现"
			waiting=1
			# MPSS 重启会把频段打回默认，等它回来要重新设置一次
			bands_done=0
			bands_try=0
		fi
		sleep "$INTERVAL"
		continue
	fi
	if [ "$waiting" = 1 ]; then
		log "基带已就绪，${GRACE}s 宽限后恢复保活"
		waiting=0
		fails=0
		grace_until=$(( $(date +%s) + GRACE ))
	fi
	# 频段放在宽限窗口里设：模组在宽限期内自己重扫，不打断刚建立的数据链路
	if [ "$bands_done" = 0 ] && [ "$bands_try" -lt 3 ]; then
		bands_try=$((bands_try + 1))
		if apply_bands; then
			bands_done=1
		elif [ "$bands_try" -ge 3 ]; then
			log "WARN 频段设置失败（已试 3 次），继续用模组当前频段"
		fi
	fi
	if [ "$(date +%s)" -lt "$grace_until" ]; then
		sleep "$INTERVAL"
		continue
	fi
	if has_ip; then
		if ping_ok; then
			if [ "$fails" -ge "$FAIL_LIMIT" ]; then
				log "LTE 恢复正常（此前连续失败 $fails 次）"
			fi
			fails=0
		else
			fails=$((fails + 1))
			[ "$fails" -ge "$FAIL_LIMIT" ] && recover
		fi
	else
		fails=$((fails + 1))
		[ "$fails" -ge "$FAIL_LIMIT" ] && recover
	fi
	sleep "$INTERVAL"
done
