#!/bin/sh /etc/rc.common
# smsrelay - 短信网关（OpenWrt / procd）
#
# 启动配置的唯一来源是 UCI /etc/config/smsrelay：每次启动把 UCI 渲染成
# /etc/smsrelay/config.json 再传给程序（程序只认 JSON）。手改 config.json
# 在下次重启会被覆盖。唯一例外是 api_token——Web 界面设置后程序会回写
# config.json，渲染时若 UCI 未填 token 则保留文件里已有的值，重启不丢。
#
# 二进制: /usr/bin/smsrelay        数据: /etc/smsrelay/sms.db（overlay 持久；别放 /var，那是 tmpfs）
# 附带:   LTE 保活实例（防 ECM-IDLE 空闲态收不到寻呼导致短信延迟）
START=99
STOP=15
USE_PROCD=1

PROG=/usr/bin/smsrelay
KEEPALIVE=/usr/bin/smsrelay-keepalive
CFG_DIR=/etc/smsrelay
CFG=$CFG_DIR/config.json

json_str() {
	# 这几个字段都是地址/端口/号码/token 这类简单值，转义 \ 和 " 就够
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

kept_token() {
	# 从现有 config.json 抠出 api_token（Web 界面设置过的值要保留）。
	# 注：简单 sed 提取，token 里若含双引号会截断——实际 token 都是
	# 字母数字，此边界仅理论存在，不值得为它上 jq 依赖。
	[ -f "$CFG" ] || return 0
	sed -n 's/.*"api_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CFG" | tail -n 1
}

write_config() {
	local host port token db guard modem own

	config_get host main listen_host '0.0.0.0'
	config_get port main listen_port '8088'
	config_get token main api_token ''
	config_get db main db_path "$CFG_DIR/sms.db"
	config_get guard main guard_interval '60'
	config_get modem main modem_index '0'
	config_get own main own_number ''

	# 数字字段防呆：填了非数字就用默认值，避免渲染出非法 JSON
	case "$port" in ''|*[!0-9]*) port=8088 ;; esac
	case "$guard" in ''|*[!0-9]*) guard=60 ;; esac

	# UCI 没填 token 时保留 Web 界面设置过的旧值
	[ -n "$token" ] || token=$(kept_token)

	mkdir -p "$CFG_DIR" "$(dirname "$db")"
	{
		printf '{\n'
		printf '  "listen_host": "%s",\n' "$(json_str "$host")"
		printf '  "listen_port": %s,\n' "$port"
		printf '  "api_token": "%s",\n' "$(json_str "$token")"
		printf '  "db_path": "%s",\n' "$(json_str "$db")"
		printf '  "guard_interval": %s,\n' "$guard"
		printf '  "modem_index": "%s",\n' "$(json_str "$modem")"
		printf '  "own_number": "%s"\n' "$(json_str "$own")"
		printf '}\n'
	} > "$CFG"
	chmod 600 "$CFG"
}

start_service() {
	local enabled ka

	config_load smsrelay
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	write_config

	procd_open_instance gateway
	procd_set_param command "$PROG" -config "$CFG"
	# 挂了自动拉起：3600s 窗口内无限次重试，间隔 5s
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	config_get_bool ka main keepalive 1
	if [ "$ka" = 1 ]; then
		procd_open_instance keepalive
		procd_set_param command "$KEEPALIVE"
		procd_set_param respawn 3600 30 0
		procd_set_param stderr 1
		procd_close_instance
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	# /etc/config/smsrelay 变更后，ubus service reload 会触发 reload_service
	procd_add_reload_trigger smsrelay
}
