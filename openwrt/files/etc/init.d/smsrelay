#!/bin/sh /etc/rc.common
# smsrelay - 短信网关（OpenWrt / procd）
#
# 配置的唯一来源是 UCI /etc/config/smsrelay：程序启动时直接读它，
# 不再渲染中间配置文件。改配置请用 LuCI（服务 → 短信网关），
# uci commit 后由下面的 reload trigger 重启服务。
#
# 二进制: /usr/bin/smsrelay
# 数据:   /etc/smsrelay/sms.db（可丢数据；升级时不保留）
# 附带:   LTE 保活实例（防 ECM-IDLE 空闲态收不到寻呼导致短信延迟）
START=99
STOP=15
USE_PROCD=1

PROG=/usr/bin/smsrelay
KEEPALIVE=/usr/bin/smsrelay-keepalive
CFG=/etc/config/smsrelay

start_service() {
	local enabled keepalive db

	config_load smsrelay
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	# 归档库的父目录必须存在，否则首次启动会因建目录失败而退出
	config_get db main db_path "/etc/smsrelay/sms.db"
	mkdir -p "${db%/*}"

	procd_open_instance gateway
	procd_set_param command "$PROG" -config "$CFG"
	# 挂了自动拉起：3600s 窗口内无限次重试，间隔 5s
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	config_get_bool keepalive main keepalive 1
	if [ "$keepalive" = 1 ] && [ -x "$KEEPALIVE" ]; then
		procd_open_instance keepalive
		procd_set_param command "$KEEPALIVE"
		procd_set_param respawn 3600 30 0
		procd_set_param stderr 1
		procd_close_instance
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	# 这是"配置改了自动生效"的关键：LuCI 保存后 uci commit
	# 会触发 procd 调用 reload_service，不需要用户手动重启。
	procd_add_reload_trigger smsrelay
}
