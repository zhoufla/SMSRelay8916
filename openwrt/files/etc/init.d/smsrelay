#!/bin/sh /etc/rc.common
# smsrelay - 短信网关（OpenWrt / procd）
# 二进制: /usr/bin/smsrelay        配置: /etc/smsrelay/config.json
# 数据:   /etc/smsrelay/sms.db    （overlay 持久；不要放 /var，那是 tmpfs）
# 附带:   LTE 保活实例（防 ECM-IDLE 空闲态收不到寻呼导致短信延迟）
START=99
STOP=15
USE_PROCD=1

PROG=/usr/bin/smsrelay
KEEPALIVE=/usr/bin/smsrelay-keepalive
CFG_DIR=/etc/smsrelay
CFG=$CFG_DIR/config.json

start_service() {
	mkdir -p "$CFG_DIR"
	if [ ! -f "$CFG" ]; then
		cat > "$CFG" <<'EOF'
{
  "listen_host": "0.0.0.0",
  "listen_port": 8088,
  "db_path": "/etc/smsrelay/sms.db",
  "guard_interval": 60
}
EOF
	fi

	procd_open_instance "gateway"
	procd_set_param command "$PROG" -config "$CFG"
	# 挂了自动拉起：3600s 窗口内无限次重试，间隔 5s
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance "keepalive"
	procd_set_param command "$KEEPALIVE"
	procd_set_param respawn 3600 30 0
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
