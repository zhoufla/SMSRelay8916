# smsrelay —— 短信网关配置（UCI）
#
# 唯一配置来源：程序只读本文件，不写。用 LuCI（服务 → 短信网关 → 设置）修改，
# uci commit 后 procd 会自动重启服务，不需要手动 /etc/init.d/smsrelay restart。
#
# 短信归档在 /etc/smsrelay/sms.db，保留配置升级时创建一致性快照并恢复。

config smsrelay 'main'
	# 服务总开关
	option enabled '1'
	# LTE 保活：周期 ICMP，防 ECM-IDLE 空闲态收不到寻呼导致短信延迟
	option keepalive '1'
	# 归档库位置（别放 /var，那是 tmpfs，重启即丢）
	option db_path '/etc/smsrelay/sms.db'
	# 短信保留天数，0 = 不自动清理
	option retain_days '30'
	# 本机号码：留空则跟随 SIM 卡（很多卡不写 EF_MSISDN）
	option own_number ''
	# 兜底扫描间隔（秒）：漏掉 D-Bus 信号时最坏多久能恢复
	option guard_interval '60'
	# ModemManager 的 modem 编号
	option modem_index '0'
	# 模组频段（可选）：竖线或逗号分隔的 mmcli 频段名，留空 = 不修改模组默认频段。
	# 本机默认只开 eutran-1/3/5，挪到移动 band 8/39/40 覆盖区会「手机有信号、
	# 模组扫不到 46000」，这时填完整列表放开，例如：
	# egsm|dcs|pcs|g850|utran-1|utran-2|utran-3|utran-5|utran-8|eutran-1|eutran-2|eutran-3|eutran-5|eutran-7|eutran-8|eutran-20|eutran-39|eutran-40
	option bands ''
	# 锁定运营商（可选）：本网 MCCMNC，移动 46000 / 联通 46001 / 电信 46011。
	# 留空 = 自动选网。模组卡在别家网络（如 CHN-CT）或一直 searching 时填上，
	# 保活脚本会在基带就绪后强制注册回本网。
	option operator ''

# 转发通道。
# 段名（ch_xxx）是稳定主键，库里按它记投递历史 —— 由 LuCI 生成后请勿手改。
config channel 'ch_demo'
	option name '示例 webhook'
	option type 'webhook'
	option enabled '0'
	option url 'https://example.com/hook'
	option method 'POST'
	option prefix '【短信】'
	# 模板的每一行一个 list 项，程序用换行拼回去；正文占位符是 %s
	list body_line '{"text":"%s"}'
	# 请求头：list header 'K: V'
	list header 'Content-Type: application/json'
	# 转发条件：全部留空 = 接收所有短信；多个条件之间 AND
	option match_peer ''
	option match_keyword ''
	option match_skip_keyword ''
	option match_code_only '0'

# DDNS 记录（Cloudflare）。段名同样是主键。
config ddns 'd_demo'
	option name 'home.example.com'
	option type 'A'
	option zone_id ''
	option api_token ''
	# iface:wwan0 取本机网卡地址；external 走公网接口查询
	option source 'external'
	option proxied '0'
	option ttl '1'
	option enabled '0'
